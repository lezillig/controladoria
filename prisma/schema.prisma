// Schema do sistema de Controladoria.
//
// Este sistema é INDEPENDENTE do sistema de gestão de motoristas — outro
// repositório, outro deploy, outro login — mas compartilha o mesmo banco
// Postgres, num SCHEMA PRÓPRIO (`controladoria`, definido pelo parâmetro
// `?schema=controladoria` na DATABASE_URL).
//
// Por que schema separado e não banco separado:
//   - Cada aplicação passa a ter a SUA tabela de migrações dentro do próprio
//     schema. Sem isso, dois `prisma migrate deploy` disputariam o mesmo
//     histórico e um sobrescreveria o outro — falha silenciosa e difícil de
//     diagnosticar.
//   - As tabelas da operação (motoristas, veículos, abastecimentos, clientes)
//     continuam alcançáveis, em SOMENTE LEITURA, pelo schema `public` — é o
//     que mantém vivos os cruzamentos que dão valor à auditoria: combustível
//     da Omie contra o extrato do cartão de frota, fornecedor cujo CPF é de um
//     motorista da folha, custo por veículo e por funcionário.
//   - Essa leitura é feita por consultas explícitas (ver src/lib/gestao),
//     nunca por modelo do Prisma: modelar aqui uma tabela de que este sistema
//     não é dono seria convite para o dia em que uma migração daqui tentasse
//     alterá-la.

generator client {
  provider = "prisma-client-js"
}

// DUAS URLs para o MESMO banco, e não uma.
//
// `url` é a conexão que a aplicação usa em produção: a do POOLER do Neon (host
// com `-pooler`). Sem pool, cada função serverless abre a própria conexão e o
// banco esgota o limite em qualquer pico.
//
// `directUrl` é a conexão DIRETA (host sem `-pooler`), usada só pelo
// `prisma migrate deploy` que roda antes do build. Migração precisa de recurso
// de sessão — advisory lock e prepared statement — que o pooler em modo
// transação não entrega. Rodar migração pelo pooler funciona até o dia em que
// não funciona, e o sintoma ("prepared statement already exists") não se parece
// nem um pouco com a causa.
//
// Em desenvolvimento local, as duas podem apontar para a mesma URL.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------- Enums ----------

enum OmieNaturezaTitulo {
  PAGAR
  RECEBER
}

enum OmieSyncStatus {
  EXECUTANDO
  CONCLUIDO
  ERRO
}

// Severidade do achado — dirige a ordenacao do relatorio e o que vira alerta
// imediato no e-mail.
enum AuditSeveridade {
  CRITICA
  ALTA
  MEDIA
  BAIXA
  INFO
}

// Natureza do achado. Separado da severidade de proposito: um indicio de
// FRAUDE de valor baixo continua sendo fraude (tratativa diferente de um erro
// de digitacao do mesmo valor), e OPORTUNIDADE nao e problema nenhum — e
// dinheiro que da pra economizar, com acao recomendada e impacto estimado.
enum AuditCategoria {
  FRAUDE
  ERRO_PROCESSO
  PERDA_FINANCEIRA
  RISCO_FINANCEIRO
  CONFORMIDADE
  OPORTUNIDADE
}

enum AuditStatus {
  ABERTO
  EM_ANALISE
  RESOLVIDO
  IGNORADO
  // Fechado automaticamente pelo motor: a condicao que gerou o achado deixou
  // de existir. Diferente de RESOLVIDO, que e tratativa humana registrada.
  OBSOLETO
}

enum RelatorioStatus {
  GERADO
  ENVIADO
  ERRO_ENVIO
}

enum BscPerspectiva {
  FINANCEIRA
  CLIENTE
  PROCESSOS_INTERNOS
  APRENDIZADO_CRESCIMENTO
}

// ---------- Conformidade ----------
// Quem produziu o documento. Importa para a leitura do risco: o mesmo
// apontamento tem peso diferente vindo de uma revisão contratada pela empresa
// e de um auto de fiscalização.
enum ConformidadeOrigem {
  CONSULTORIA
  CONTABILIDADE
  AUDITORIA_EXTERNA
  FISCALIZACAO
  JURIDICO
  INTERNO
}

// Área do risco — é o que endereça o apontamento a um responsável. Deliberadamente
// mais larga que a lista de agentes: a consultoria aponta coisa que este sistema
// não tem como ver (trabalhista, societário, LGPD), e esconder isso atrás de uma
// taxonomia financeira faria o módulo perder justamente o que ele acrescenta.
enum ConformidadeArea {
  FISCAL
  TRABALHISTA
  PREVIDENCIARIO
  CONTABIL
  FINANCEIRO
  SOCIETARIO
  REGULATORIO
  CONTRATUAL
  LGPD
  OUTRO
}

// Estado da leitura do arquivo. PENDENTE não é erro: é o estado normal quando
// a leitura por IA não está habilitada — o documento fica guardado como
// evidência e os apontamentos são cadastrados à mão.
enum ConformidadeExtracao {
  PENDENTE
  EXTRAIDO
  MANUAL
  ERRO
}

// O QUE o apontamento é. Aprendido lendo os relatórios reais que o grupo
// recebe: a consultoria não produz uma lista homogênea de "riscos" — produz
// quatro coisas diferentes, que se resolvem de formas diferentes, e tratar
// todas como "risco" faz a lista inteira parecer igualmente grave.
//
//   DOCUMENTO      resolve-se enviando um arquivo (é a maior parte da lista, e
//                  a que mais reincide: "apuração de IRPJ/CSLL do 2º tri/24"
//                  foi pedida em dez/25 e continuava pendente em jul/26)
//   QUESTIONAMENTO resolve-se com uma resposta da contabilidade
//   DIVERGENCIA    consultoria e contabilidade discordam — só uma decisão da
//                  empresa encerra, e enquanto não encerra o risco corre
//   OBRIGACAO      obrigação acessória entregue fora do prazo ou não entregue
//   RISCO          exposição identificada (enquadramento, tese, contingência)
//   OPORTUNIDADE   dinheiro a recuperar (pagamento a maior, crédito não usado)
enum ConformidadeNatureza {
  RISCO
  DOCUMENTO
  QUESTIONAMENTO
  DIVERGENCIA
  OBRIGACAO
  OPORTUNIDADE
}

// Tratativa do apontamento. ACEITO_COM_RISCO existe separado de RESOLVIDO e de
// NAO_SE_APLICA de propósito: é a decisão consciente de conviver com o risco —
// legítima, comum, e a que mais precisa ficar registrada com nome e data.
enum ConformidadeStatus {
  ABERTO
  EM_TRATATIVA
  RESOLVIDO
  ACEITO_COM_RISCO
  NAO_SE_APLICA
}

// ============================================================================
// Conexão Omie
// ============================================================================
// O grupo opera com mais de um CNPJ (Azul e MCZ), cada um com sua própria
// conta na Omie e sua própria numeração de lançamentos. Isso NÃO é detalhe de
// configuração: o título nº 12345 existe nas duas contas e são documentos
// diferentes. Sem a dimensão de conexão em cada chave única, um sobrescreveria
// o outro em silêncio — e num sistema de auditoria o número errado é pior que
// número nenhum, porque parece plausível.
//
// Toda tabela espelhada carrega `conexaoId`, e toda chave natural inclui a
// conexão. O `apelido` vai desnormalizado junto, para tela, relatório e chave
// de achado mostrarem a empresa de origem sem depender de join.
model OmieConexao {
  id            String   @id @default(cuid())
  companyId     String
  nome          String
  // Rótulo curto usado em filtros, listas e chaves de achado ("AZUL", "MCZ").
  apelido       String
  cnpj          String?
  // Nome do SUFIXO das variáveis de ambiente que guardam as credenciais:
  // `AZUL` resolve para OMIE_APP_KEY_AZUL / OMIE_APP_SECRET_AZUL.
  //
  // A credencial em si NUNCA é gravada no banco. Guardar app_key/app_secret
  // aqui significaria que um vazamento de banco (backup, dump, acesso de
  // leitura de um terceiro) entregaria acesso ao ERP financeiro do grupo. O
  // banco guarda apenas o NOME da variável de ambiente.
  credencialRef String
  ativa         Boolean  @default(true)
  ordem         Int      @default(0)
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt

  parceiros       OmieParceiro[]
  categorias      OmieCategoria[]
  departamentos   OmieDepartamento[]
  projetos        OmieProjeto[]
  contasCorrentes OmieContaCorrente[]
  titulos         OmieTitulo[]
  baixas          OmieBaixa[]
  movimentos      OmieMovimento[]
  notas           OmieNota[]
  syncRuns        OmieSyncRun[]

  // SetNull nos dois: desativar/remover uma conexão não pode apagar o
  // relatório da consultoria nem os apontamentos já tratados — eles viram
  // documento do grupo, que é o que de fato são a partir dali.
  conformidadeDocumentos   ConformidadeDocumento[]
  conformidadeApontamentos ConformidadeApontamento[]

  @@unique([companyId, apelido])
  @@unique([companyId, credencialRef])
  @@index([companyId, ativa])
}

// ============================================================================
// Espelho da Omie
// ============================================================================
// Espelho LOCAL, somente leitura: nada aqui é fonte de verdade contábil, a
// Omie é. O espelho existe porque auditoria de verdade precisa de três coisas
// que a API sozinha não dá: histórico estável (o achado precisa provar o que
// estava lá ontem), cruzamento entre domínios, e consulta rápida o bastante
// para rodar dezenas de regras num relatório diário sem estourar o limite de
// chamadas da Omie.
//
// Todo valor monetário em CENTAVOS (Int): float em dinheiro acumula erro de
// arredondamento e, num sistema cujo propósito é apontar divergência de
// centavos, isso geraria achado falso.
//
// Todo código vindo da Omie é String, não Int: os códigos reais passam de 10
// dígitos e estouram o Int32 do Postgres.

model OmieParceiro {
  id                      String      @id @default(cuid())
  companyId               String
  conexaoId               String
  conexao                 OmieConexao @relation(fields: [conexaoId], references: [id], onDelete: Cascade)
  conexaoApelido          String
  codigoOmie              String
  codigoIntegracao        String?
  nome                    String
  nomeFantasia            String?
  // Somente dígitos — o cruzamento com o CPF do motorista (fornecedor que é
  // funcionário) só funciona com os dois lados normalizados.
  documento               String?
  ehCliente               Boolean     @default(false)
  ehFornecedor            Boolean     @default(false)
  email                   String?
  cidade                  String?
  estado                  String?
  inativo                 Boolean     @default(false)
  bloqueado               Boolean     @default(false)
  // Hash SHA-256 de banco+agência+conta, NUNCA os dados em claro. Serve a um
  // propósito único: detectar TROCA de conta bancária de fornecedor entre duas
  // sincronizações — o vetor mais comum de fraude de boleto/PIX no Brasil. O
  // hash dá o alerta sem este sistema virar mais um lugar de onde vazar dado
  // bancário de terceiro.
  contaBancariaHash       String?
  contaBancariaAlteradaEm DateTime?
  // QUANDO ESTE FORNECEDOR PASSOU A EXISTIR — duas fontes, nesta ordem.
  //
  // `sincronizadoEm` NÃO serve para isso, e a confusão entre os dois deixou a
  // regra de empresa de fachada sem efeito por meses: ele é reescrito a cada
  // sincronização, então todo fornecedor parecia ter sido cadastrado hoje.
  //
  // `dataCadastroOmie` é a verdade — vem do `info.dInc` da própria Omie.
  // `primeiraVezEm` é o substituto quando a conta não devolve aquele bloco:
  // gravado na CRIAÇÃO da linha e nunca mais tocado. Não é a data real do
  // cadastro (é a data em que o espelho o viu pela primeira vez), mas responde
  // "apareceu agora?" para tudo que surgir daqui em diante.
  //
  // Os dois são opcionais de propósito: para as linhas que já existiam quando
  // esta coluna nasceu, não há resposta, e a regra se cala em vez de tratar
  // fornecedor antigo como novo.
  dataCadastroOmie        DateTime?
  primeiraVezEm           DateTime?
  sincronizadoEm          DateTime    @default(now())

  @@unique([conexaoId, codigoOmie])
  @@index([companyId, documento])
}

model OmieCategoria {
  id                String      @id @default(cuid())
  companyId         String
  conexaoId         String
  conexao           OmieConexao @relation(fields: [conexaoId], references: [id], onDelete: Cascade)
  conexaoApelido    String
  codigo            String
  descricao         String
  natureza          String?
  categoriaSuperior String?
  totalizadora      Boolean     @default(false)
  inativa           Boolean     @default(false)
  // A classificação contábil que a Omie já mandava e era descartada.
  // `codigoDre` é o código do plano de DRE da própria empresa; as duas marcas
  // dizem de que lado a categoria entra. Juntos, são o que permite propor a
  // linha do DRE em vez de adivinhar pelo nome da categoria.
  codigoDre         String?
  tipoCategoria     String?
  contaReceita      Boolean     @default(false)
  contaDespesa      Boolean     @default(false)
  sincronizadoEm    DateTime    @default(now())

  @@unique([conexaoId, codigo])
  @@index([companyId])
}

model OmieDepartamento {
  id             String      @id @default(cuid())
  companyId      String
  conexaoId      String
  conexao        OmieConexao @relation(fields: [conexaoId], references: [id], onDelete: Cascade)
  conexaoApelido String
  codigo         String
  descricao      String
  estrutura      String?
  inativo        Boolean     @default(false)
  sincronizadoEm DateTime    @default(now())

  @@unique([conexaoId, codigo])
  @@index([companyId])
}

model OmieProjeto {
  id             String      @id @default(cuid())
  companyId      String
  conexaoId      String
  conexao        OmieConexao @relation(fields: [conexaoId], references: [id], onDelete: Cascade)
  conexaoApelido String
  codigo         String
  nome           String
  inativo        Boolean     @default(false)
  sincronizadoEm DateTime    @default(now())

  @@unique([conexaoId, codigo])
  @@index([companyId])
}

model OmieContaCorrente {
  id                String      @id @default(cuid())
  companyId         String
  conexaoId         String
  conexao           OmieConexao @relation(fields: [conexaoId], references: [id], onDelete: Cascade)
  conexaoApelido    String
  codigo            String
  descricao         String
  tipo              String?
  banco             String?
  agencia           String?
  numeroConta       String?
  saldoInicialCents Int         @default(0)
  inativa           Boolean     @default(false)
  // Marcas da própria Omie que excluem a conta do resumo de caixa e da
  // projeção de fluxo. Guardadas porque uma conta por onde passa dinheiro e
  // que não aparece no relatório de caixa da empresa é, no mínimo, uma
  // pergunta — e havia usos legítimos demais (aplicação, cartão,
  // transferência interna) para transformar a marca em suspeita automática.
  naoEntraNoResumo  Boolean     @default(false)
  naoEntraNoFluxo   Boolean     @default(false)
  sincronizadoEm    DateTime    @default(now())

  @@unique([conexaoId, codigo])
  @@index([companyId])
}

// Uma tabela para as duas naturezas (pagar e receber), discriminadas por
// `natureza`. As regras de auditoria são quase simétricas — duas tabelas
// obrigariam a escrever cada regra duas vezes, e é exatamente aí que uma das
// cópias fica para trás.
model OmieTitulo {
  id               String             @id @default(cuid())
  companyId        String
  conexaoId        String
  conexao          OmieConexao        @relation(fields: [conexaoId], references: [id], onDelete: Cascade)
  conexaoApelido   String
  natureza         OmieNaturezaTitulo
  codigoLancamento String
  codigoIntegracao String?

  parceiroCodigo    String?
  // Nome desnormalizado: o relatório lista dezenas de títulos e não pode
  // depender de join com um cadastro que talvez ainda não tenha sido
  // sincronizado (a Omie devolve o título antes do cadastro se o backfill
  // parou no meio).
  parceiroNome      String?
  parceiroDocumento String?

  numeroDocumento     String?
  numeroParcela       String?
  tipoDocumento       String?
  categoriaCodigo     String?
  categoriaDescricao  String?
  departamentoCodigo  String?
  projetoCodigo       String?
  contaCorrenteCodigo String?

  dataEmissao    DateTime?
  dataVencimento DateTime
  dataPrevisao   DateTime?
  dataRegistro   DateTime?
  dataEntrada    DateTime?

  valorDocumentoCents Int
  saldoCents          Int?
  // Totais consolidados das baixas. Ficam aqui, e não só na tabela de baixas,
  // porque toda regra de perda financeira ("pagou juros", "pagou acima do
  // documento") filtra por esses valores sobre milhares de títulos — agregar
  // por join a cada regra era o gargalo do relatório diário.
  valorPagoCents      Int       @default(0)
  jurosCents          Int       @default(0)
  multaCents          Int       @default(0)
  descontoCents       Int       @default(0)
  tarifaCents         Int       @default(0)

  // RETENÇÕES NA FONTE, como a Omie as lança no título.
  //
  // O diagnóstico das duas contas mostrou que a resposta traz `nValorIR`,
  // `nValorISS`, `nValorPIS`, `nValorCOFINS`, `nValorCSLL` e `nValorINSS` em
  // todo título, e que nada disso estava sendo guardado.
  //
  // Para uma controladoria é dinheiro, não detalhe fiscal: a retenção muda o
  // que de fato entra e sai. Um título a receber de R$ 100 mil com R$ 11 mil
  // retidos deposita R$ 89 mil, e um relatório que só conhece o valor do
  // documento erra o caixa exatamente nesse valor. Do lado a pagar, a retenção
  // é obrigação que a empresa recolhe no lugar do prestador — retenção lançada
  // e não recolhida é das divergências que a consultoria aponta todo mês.
  //
  // SEPARADAS POR IMPOSTO, e não somadas: cada uma tem guia, prazo e alíquota
  // própria, e conferir contra a DCTFWeb exige o número por tributo. O total
  // sozinho não conferiria com nada.
  //
  // `@default(0)` e não opcional: a Omie omite o campo quando não há valor, e
  // ausência aqui significa retenção zero — não retenção desconhecida.
  retencaoIrCents     Int       @default(0)
  retencaoIssCents    Int       @default(0)
  retencaoPisCents    Int       @default(0)
  retencaoCofinsCents Int       @default(0)
  retencaoCsllCents   Int       @default(0)
  retencaoInssCents   Int       @default(0)

  dataUltimaBaixa     DateTime?

  // Texto cru da Omie ("ATRASADO", "A VENCER", "PAGO", "LIQUIDADO",
  // "CANCELADO"...). Não normalizado para enum de propósito: um status novo do
  // ERP não pode quebrar o sync.
  status         String
  liquidado      Boolean   @default(false)
  cancelado      Boolean   @default(false)
  observacao     String?
  origem         String?
  alteradoEmOmie DateTime?
  sincronizadoEm DateTime  @default(now())

  baixas OmieBaixa[]

  @@unique([conexaoId, natureza, codigoLancamento])
  @@index([companyId, natureza, dataVencimento])
  @@index([companyId, natureza, status])
  @@index([companyId, dataUltimaBaixa])
  @@index([companyId, parceiroCodigo])
}

// Cada pagamento/recebimento de um título. É aqui que moram juros, multa,
// desconto e tarifa — os números que respondem "quanto a má gestão de prazo
// custou este mês", que o título sozinho não conta.
model OmieBaixa {
  id                  String      @id @default(cuid())
  companyId           String
  conexaoId           String
  conexao             OmieConexao @relation(fields: [conexaoId], references: [id], onDelete: Cascade)
  tituloId            String
  titulo              OmieTitulo  @relation(fields: [tituloId], references: [id], onDelete: Cascade)
  // Chave natural dentro da conexão. Existe porque nem todo endpoint de baixa
  // da Omie devolve identificador próprio, e sem chave estável a reimportação
  // duplicaria as baixas — inflando o juros do relatório.
  chave               String
  dataBaixa           DateTime
  valorCents          Int
  jurosCents          Int         @default(0)
  multaCents          Int         @default(0)
  descontoCents       Int         @default(0)
  tarifaCents         Int         @default(0)
  contaCorrenteCodigo String?
  observacao          String?
  liquidaTitulo       Boolean     @default(true)
  sincronizadoEm      DateTime    @default(now())

  @@unique([conexaoId, chave])
  @@index([companyId, dataBaixa])
  @@index([tituloId])
}

// Base da conciliação bancária: o que de fato entrou e saiu da conta,
// independente de existir título. Movimento sem título e título baixado sem
// movimento são os dois lados do mesmo furo.
model OmieMovimento {
  id                  String      @id @default(cuid())
  companyId           String
  conexaoId           String
  conexao             OmieConexao @relation(fields: [conexaoId], references: [id], onDelete: Cascade)
  conexaoApelido      String
  contaCorrenteCodigo String
  codigoLancamento    String
  data                DateTime
  // Com sinal: negativo = saída. Somar valor absoluto e depois aplicar sinal
  // por natureza é a receita clássica para o erro de sinal invertido.
  valorCents          Int
  natureza            String?
  tipo                String?
  categoriaCodigo     String?
  parceiroCodigo      String?
  parceiroNome        String?
  documento           String?
  observacao          String?
  conciliado          Boolean     @default(false)
  dataConciliacao     DateTime?
  tituloCodigo        String?
  sincronizadoEm      DateTime    @default(now())

  @@unique([conexaoId, codigoLancamento])
  @@index([companyId, data])
  @@index([companyId, contaCorrenteCodigo, data])
}

// Cabeçalho de NF-e e NFS-e. Não guarda item nem XML completo: o objetivo é
// análise fiscal agregada (carga tributária efetiva, nota cancelada com título
// ativo, faturamento sem nota) — não substituir o arquivo fiscal, que continua
// sendo o da Omie/contador.
model OmieNota {
  id                 String      @id @default(cuid())
  companyId          String
  conexaoId          String
  conexao            OmieConexao @relation(fields: [conexaoId], references: [id], onDelete: Cascade)
  conexaoApelido     String
  tipo               String
  chave              String
  numero             String?
  serie              String?
  chaveAcesso        String?
  dataEmissao        DateTime
  parceiroCodigo     String?
  parceiroNome       String?
  valorCents         Int
  valorServicosCents Int?
  baseIssCents       Int?
  valorIssCents      Int?
  valorPisCents      Int?
  valorCofinsCents   Int?
  valorIcmsCents     Int?
  valorIpiCents      Int?
  valorIrCents       Int?
  valorCsllCents     Int?
  valorInssCents     Int?
  cancelada          Boolean     @default(false)
  naturezaOperacao   String?
  cfop               String?
  sincronizadoEm     DateTime    @default(now())

  @@unique([conexaoId, chave])
  @@index([companyId, dataEmissao])
}

// Uma linha por execução do ciclo (que pode ter várias invocações
// encadeadas). É também a evidência de que o sistema está mesmo em D-1: o
// agente administrativo audita esta tabela e abre achado quando a última
// execução concluída ficou para trás.
model OmieSyncRun {
  id             String         @id @default(cuid())
  companyId      String
  conexaoId      String?
  conexao        OmieConexao?   @relation(fields: [conexaoId], references: [id], onDelete: SetNull)
  iniciadoEm     DateTime       @default(now())
  finalizadoEm   DateTime?
  status         OmieSyncStatus @default(EXECUTANDO)
  // Fase da máquina de estados. Persistida porque cada invocação encadeada é
  // um processo novo, sem memória da anterior.
  fase           String         @default("cadastros")
  // Batimento da execução. Cada passo da máquina de estados grava algo nesta
  // linha, então o carimbo avança a cada ~40 segundos enquanto o ciclo vive.
  //
  // Existe para responder a única pergunta que quem espera uma carga de horas
  // realmente faz: está andando ou travou? Sem ele, uma execução morta e uma
  // execução trabalhando são indistinguíveis na tela — as duas aparecem como
  // EXECUTANDO, com o mesmo horário de início.
  atualizadoEm   DateTime       @updatedAt
  cursor         String?
  janelaInicio   DateTime
  janelaFim      DateTime
  backfill       Boolean        @default(false)
  invocacoes     Int            @default(1)
  cadastros      Int            @default(0)
  titulosPagar   Int            @default(0)
  titulosReceber Int            @default(0)
  baixas         Int            @default(0)
  movimentos     Int            @default(0)
  notas          Int            @default(0)
  achados        Int            @default(0)
  erro           String?
  detalhes       Json?

  @@index([companyId, iniciadoEm])
  @@index([companyId, status])
  @@index([conexaoId, status])
}

// ============================================================================
// Achados de auditoria
// ============================================================================
// Persistido, e não recalculado a cada carregamento, por três motivos: o
// achado precisa de TRATATIVA (alguém marca como resolvido e escreve o
// porquê), de HISTÓRICO (quando apareceu, quanto tempo levou para ser tratado
// — o indicador de controle interno) e precisa aparecer no e-mail do dia
// seguinte mesmo que o dado de origem já tenha mudado.
model AuditFinding {
  id                  String          @id @default(cuid())
  companyId           String
  // Conexão a que o achado se refere. Nulo em achados consolidados do grupo
  // (ex.: projeção de caixa somando as duas empresas).
  conexaoId           String?
  conexaoApelido      String?
  agente              String
  regra               String
  severidade          AuditSeveridade
  categoria           AuditCategoria
  titulo              String
  descricao           String
  recomendacao        String?
  // Dinheiro do fato (ex.: valor do título pago em duplicidade).
  valorCents          Int?
  // Economia/recuperação estimada se a recomendação for executada. Separado de
  // valorCents de propósito: num juros de R$ 5.000 pago, valorCents é a perda
  // consumada e impactoCents é o que dá para evitar daqui para frente — somar
  // os dois no mesmo campo inflaria o total do relatório.
  impactoCents        Int?
  dataReferencia      DateTime?
  entidadeTipo        String?
  entidadeId          String?
  entidadeRef         String?
  evidencia           Json?
  // Chave determinística (agente + regra + conexão + entidade + período). Uma
  // reexecução sobre o mesmo dado reencontra o achado em vez de duplicar — é o
  // que permite rodar a auditoria todo dia sem a lista virar lixo, e o que
  // preserva a tratativa já feita por uma pessoa.
  chave               String
  // Confiança atribuída pelo SUPERVISOR (0-100), não pelo agente que emitiu.
  // Um agente determinístico sempre "tem certeza" do que calculou; quem sabe
  // se o dado de base era confiável, se outro agente disse o contrário e se o
  // achado já foi julgado falso-positivo é a camada de revisão.
  confianca           Int             @default(100)
  // O que o supervisor mudou e por quê. Fica visível na UI junto do achado:
  // revisão invisível é indistinguível de censura.
  notaSupervisor      String?
  chaveRelacionada    String?
  status              AuditStatus     @default(ABERTO)
  detectadoEm         DateTime        @default(now())
  atualizadoEm        DateTime        @updatedAt
  ultimaOcorrencia    DateTime        @default(now())
  ocorrencias         Int             @default(1)
  resolvidoEm         DateTime?
  tratadoPorUserId    String?
  observacaoTratativa String?

  // Apontamentos de conformidade que este achado confirma. É a ponte entre o
  // que a consultoria escreveu no relatório mensal e o que os agentes veem
  // todo dia nos dados.
  vinculosConformidade ConformidadeVinculo[]

  @@unique([companyId, chave])
  @@index([companyId, status, severidade])
  @@index([companyId, categoria, status])
  @@index([companyId, detectadoEm])
  @@index([conexaoId, status])
}

// ============================================================================
// Relatório diário
// ============================================================================
// O HTML enviado fica guardado inteiro: o relatório é uma peça de
// controladoria com data — o que se sabia naquele dia, com os números daquele
// dia. Reconstruí-lo depois a partir da base atual daria outro resultado, e
// perderia justamente o valor de trilha.
model RelatorioDiario {
  id              String          @id @default(cuid())
  companyId       String
  dataReferencia  DateTime
  // Nulo = relatório consolidado do grupo. Preenchido = relatório de uma
  // empresa só (ver ControladoriaConfig.relatorioPorConexao).
  conexaoId       String?
  conexaoApelido  String?
  geradoEm        DateTime        @default(now())
  enviadoEm       DateTime?
  status          RelatorioStatus @default(GERADO)
  destinatarios   String
  assunto         String
  html            String
  resumo          Json
  narrativaIa     Json?
  erro            String?
  achadosTotal    Int             @default(0)
  achadosCriticos Int             @default(0)

  @@unique([companyId, dataReferencia, conexaoId])
  @@index([companyId, dataReferencia])
}

// Parâmetros do modelo de gestão financeira da empresa. São os números que
// transformam regra genérica em política DESTA empresa: sem alçada cadastrada,
// por exemplo, o agente antifraude não tem como saber que três pagamentos de
// R$ 9.900 no mesmo dia são fracionamento de um de R$ 29.700.
model ControladoriaConfig {
  id                                  String   @id @default(cuid())
  companyId                           String   @unique
  emailsRelatorio                     String   @default("")
  dataInicioBase                      DateTime
  limiteAlcadaCents                   Int?
  metaMargemPercent                   Float?
  toleranciaVariacaoPercent           Float    @default(20)
  diasAtrasoCritico                   Int      @default(30)
  saldoMinimoCaixaCents               Int?
  limiteConcentracaoFornecedorPercent Float    @default(25)
  // Um e-mail consolidado do grupo, ou um por empresa. Grupo cujos CNPJs
  // operam junto costuma querer o consolidado; quando cada empresa tem gestor
  // próprio, o separado funciona melhor.
  relatorioPorConexao                 Boolean  @default(false)
  // Se o ciclo diário gera relatório depois de auditar. Nasce DESLIGADO de
  // propósito: durante a integração com a Omie o que se quer é espelhar e
  // conferir os dados, e um relatório gerado todo dia sobre uma base ainda
  // incompleta produziria histórico enganoso — documento com data, com
  // números que ninguém validou, guardado como se fosse retrato do dia.
  //
  // Não desliga a auditoria: os agentes continuam rodando, porque é o achado
  // que revela o que ficou faltando no espelho. Também não impede a geração
  // manual em Relatórios, que é como se confere o resultado antes de ligar o
  // automático.
  relatorioAutomatico                 Boolean  @default(false)
  // Somar ao DRE os tributos que os clientes retiveram na fonte. Ligado
  // quando o retido NÃO vira título a pagar (os dois se completam); desligado
  // quando a empresa lança o imposto cheio e abate a retenção ao recolher (o
  // título já contém o valor, e somar duplicaria).
  retencoesNasDeducoes                Boolean  @default(true)
  atualizadoEm                        DateTime @updatedAt
}

// ============================================================================
// BSC — Balanced Scorecard
// ============================================================================
// O catálogo de indicadores (código, perspectiva, unidade, direção, fórmula)
// vive em CÓDIGO (src/lib/controladoria/bsc.ts): a fórmula de um indicador é
// regra de negócio versionada, revisável em diff, não dado editável em tela. O
// banco guarda só o que é decisão da empresa (a meta) e o que é histórico (a
// medição de cada dia).

model BscMeta {
  id                  String   @id @default(cuid())
  companyId           String
  codigo              String
  meta                Float
  // Faixa amarela: quanto o realizado pode se afastar da meta antes de virar
  // vermelho (em % da meta).
  toleranciaPercent   Float    @default(10)
  ativo               Boolean  @default(true)
  observacao          String?
  atualizadoEm        DateTime @updatedAt
  atualizadoPorUserId String?

  @@unique([companyId, codigo])
}

// Medição diária. É o que dá tendência ao BSC e o que permite auditar depois
// "o indicador estava mesmo verde naquele dia?" — recalcular a partir da base
// de hoje não responde isso.
model BscSnapshot {
  id             String         @id @default(cuid())
  companyId      String
  dataReferencia DateTime
  codigo         String
  perspectiva    BscPerspectiva
  valor          Float?
  meta           Float?
  // "VERDE" | "AMARELO" | "VERMELHO" | "SEM_META" | "SEM_DADO"
  farol          String
  detalhes       Json?
  criadoEm       DateTime       @default(now())

  @@unique([companyId, dataReferencia, codigo])
  @@index([companyId, codigo, dataReferencia])
}

// ============================================================================
// Rateio / unit economics
// ============================================================================
// De-para entre a dimensão de custo da Omie (departamento, projeto, categoria,
// fornecedor ou um texto do título) e os cadastros operacionais que vivem no
// sistema de gestão (Cliente = contrato, Vehicle = placa, Driver = pessoa).
//
// Os ids de destino apontam para tabelas do schema `public`, de outro sistema,
// e por isso NÃO há chave estrangeira: este sistema não é dono daquelas
// tabelas e não pode impedir que a gestão apague um cadastro. O vínculo órfão
// é tratado na leitura — o destino não é encontrado e o custo volta para "não
// alocado", que é o comportamento correto: melhor um custo não alocado e
// visível do que um número errado com aparência de certo.
model OmieVinculoCentroCusto {
  id                  String    @id @default(cuid())
  companyId           String
  // "DEPARTAMENTO" | "PROJETO" | "CATEGORIA" | "PARCEIRO" | "TEXTO"
  tipoOrigem          String
  valorOrigem         String
  rotuloOrigem        String?
  // Nulo = vale para todas as conexões (ex.: uma regra por TEXTO). Preenchido
  // = só para aquela empresa, que é o caso comum de departamento e categoria,
  // já que os códigos são independentes entre as contas Omie.
  conexaoId           String?
  clienteId           String?
  vehicleId           String?
  driverId            String?
  // Percentual do valor do título que vai para este destino. Permite ratear um
  // custo compartilhado (ex.: aluguel da garagem) em vez de obrigar tudo ou
  // nada. Quando a soma não fecha 100%, o resto entra em "não alocado" e vira
  // achado — em vez de o sistema inventar um rateio.
  percentual          Float     @default(100)
  // Sugestão automática ainda não confirmada. Sugestão NUNCA entra no cálculo
  // sozinha: a máquina sugere, a pessoa confirma.
  sugerido            Boolean   @default(false)
  confirmadoPorUserId String?
  confirmadoEm        DateTime?
  criadoEm            DateTime  @default(now())
  atualizadoEm        DateTime  @updatedAt

  @@index([companyId, tipoOrigem])
  @@index([companyId, conexaoId])
}

// ============================================================================
// Conformidade — o que vem de fora
// ============================================================================
// Este sistema audita os DADOS. Uma consultoria audita a EMPRESA: contrato,
// obrigação acessória, enquadramento, processo, contingência. São duas leituras
// diferentes do mesmo risco, e o valor está em cruzá-las.
//
// Três coisas passam a ser possíveis quando o relatório mensal da consultoria
// entra no sistema em vez de ficar num anexo de e-mail:
//
//   1. CONFIRMAÇÃO CRUZADA. Quando a consultoria aponta "juros relevantes por
//      atraso" e o agente de contas a pagar já vinha apontando os títulos um a
//      um, o risco deixa de ser opinião — duas fontes independentes chegaram
//      nele por caminhos diferentes.
//   2. PONTO CEGO, dos dois lados. Apontamento sem nenhum achado correspondente
//      é coisa que este sistema não sabe ver (e talvez devesse). Achado sem
//      apontamento é coisa que a consultoria não viu.
//   3. REINCIDÊNCIA. O mesmo apontamento repetido em três meses seguidos não é
//      três problemas: é um processo que nunca foi corrigido — e esse é o sinal
//      de controle interno mais forte que existe, invisível quando cada
//      relatório é lido isolado.

model ConformidadeDocumento {
  id             String       @id @default(cuid())
  companyId      String
  // Empresa a que o documento se refere. Nulo = documento do grupo (o caso de
  // uma consultoria que analisa os dois CNPJs no mesmo relatório).
  conexaoId      String?
  conexao        OmieConexao? @relation(fields: [conexaoId], references: [id], onDelete: SetNull)
  conexaoApelido String?

  titulo        String
  origem        ConformidadeOrigem @default(CONSULTORIA)
  // Quem emitiu (nome do escritório/consultoria). Texto livre: não vale criar
  // cadastro de fornecedor de serviço para um campo que aparece em relatório.
  emissor       String?
  // Mês a que o documento se refere, sempre no dia 1. É a chave da leitura
  // mês a mês — sem ela não há como dizer "o relatório de julho não chegou".
  competencia   DateTime
  dataDocumento DateTime?

  arquivoNome   String
  mimeType      String
  tamanhoBytes  Int
  // SHA-256 do arquivo. Serve a dois propósitos: impedir o mesmo anexo de
  // entrar duas vezes (e duplicar todos os apontamentos dele), e provar depois
  // que o arquivo guardado é byte a byte o que a consultoria enviou.
  sha256        String
  // O arquivo original, no banco. Não em armazenamento externo, de propósito:
  // são poucos documentos por mês, e um apontamento cuja evidência de origem
  // se perdeu não vale nada numa discussão com o fisco ou com o auditor. Nunca
  // é lido nas listagens — só na rota de download (ver o comentário lá).
  conteudo      Bytes
  textoExtraido String?

  extracao     ConformidadeExtracao @default(PENDENTE)
  extracaoErro String?
  extraidoEm   DateTime?
  resumo       String?

  enviadoPorUserId String?
  enviadoPorNome   String?
  criadoEm         DateTime @default(now())
  atualizadoEm     DateTime @updatedAt

  apontamentos ConformidadeApontamento[]

  @@unique([companyId, sha256])
  @@index([companyId, competencia])
}

model ConformidadeApontamento {
  id             String       @id @default(cuid())
  companyId      String
  conexaoId      String?
  conexao        OmieConexao? @relation(fields: [conexaoId], references: [id], onDelete: SetNull)
  conexaoApelido String?

  // Anulável, e com SetNull: um apontamento já tratado por uma pessoa sobrevive
  // à exclusão do arquivo que o originou. O trabalho humano vale mais que o
  // vínculo com o anexo.
  documentoId String?
  documento   ConformidadeDocumento? @relation(fields: [documentoId], references: [id], onDelete: SetNull)

  competencia  DateTime
  area         ConformidadeArea     @default(OUTRO)
  natureza     ConformidadeNatureza @default(RISCO)
  severidade   AuditSeveridade      @default(MEDIA)
  titulo       String
  descricao    String
  recomendacao String?

  // Norma que sustenta o apontamento, e o código da obrigação no catálogo do
  // sistema (src/lib/conformidade/obrigacoes.ts). Guardar o CÓDIGO, e não o
  // texto do prazo e do risco, é o que permite corrigir a fundamentação num
  // lugar só quando a legislação mudar — sem reescrever apontamento antigo, que
  // é registro histórico e não pode ser alterado retroativamente.
  baseLegal       String?
  obrigacaoCodigo String?

  // Competência a que o apontamento SE REFERE, quando é outra que não a do
  // relatório. É o caso mais comum da lista de documentos pendentes: o
  // relatório de julho/26 cobra a apuração do 2º trimestre de 2024.
  //
  // Separada de `competencia` de propósito, e não em vez dela: a reincidência
  // se conta pelas competências dos RELATÓRIOS em que o assunto reapareceu.
  // Se o registro fosse arquivado na competência de origem, as cinco cobranças
  // do mesmo trimestre colapsariam numa só e o sistema mostraria "1 ocorrência"
  // para um problema que a empresa arrasta há oito meses — exatamente o
  // contrário do que este módulo existe para mostrar.
  competenciaAlvo DateTime?

  // Trecho literal do documento que originou o apontamento, e a página. É o que
  // permite conferir a leitura contra a fonte sem reabrir o PDF inteiro — e o
  // que impede o módulo de virar um resumo em que ninguém confia.
  trechoOrigem String?
  paginaOrigem String?

  valorEnvolvidoCents Int?

  status              ConformidadeStatus @default(ABERTO)
  responsavel         String?
  prazo               DateTime?
  observacaoTratativa String?
  tratadoPorUserId    String?
  resolvidoEm         DateTime?

  // Proposto pela leitura automática e ainda não conferido por uma pessoa.
  // Enquanto `validado` for falso, o apontamento aparece marcado como proposta:
  // texto extraído por máquina não pode entrar no relatório da diretoria com a
  // mesma autoridade de um ponto conferido.
  propostoPorIa     Boolean   @default(false)
  validado          Boolean   @default(false)
  validadoPorUserId String?
  validadoEm        DateTime?

  // Assunto canônico do apontamento, normalizado. É o que reconhece o MESMO
  // ponto entre competências diferentes mesmo quando a consultoria reescreve a
  // frase — a base da detecção de reincidência.
  chaveRecorrencia    String
  primeiraCompetencia DateTime
  ocorrencias         Int      @default(1)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  vinculos ConformidadeVinculo[]

  @@index([companyId, status, severidade])
  @@index([companyId, competencia])
  @@index([companyId, chaveRecorrencia])
  @@index([documentoId])
}

// Ligação entre um apontamento da consultoria e um achado dos agentes.
//
// A sugestão é automática e por semelhança de texto — portanto falível, e por
// isso nasce marcada como sugestão. Só depois que uma pessoa confirma é que o
// par passa a valer como confirmação cruzada no relatório. Máquina propõe a
// ligação; gente decide que ela é verdadeira.
model ConformidadeVinculo {
  id            String                  @id @default(cuid())
  companyId     String
  apontamentoId String
  apontamento   ConformidadeApontamento @relation(fields: [apontamentoId], references: [id], onDelete: Cascade)
  achadoId      String
  achado        AuditFinding            @relation(fields: [achadoId], references: [id], onDelete: Cascade)
  // Chave do achado desnormalizada: o vínculo continua legível no histórico
  // mesmo depois de o achado mudar de status.
  achadoChave   String
  // "CONFIRMA" (mesmo fato, visto pelos dois lados) | "RELACIONADO" (assunto
  // vizinho, útil como contexto).
  tipo          String                  @default("CONFIRMA")
  automatico    Boolean                 @default(true)
  // Pontuação da semelhança que gerou a sugestão (0-100). Fica gravada para a
  // regra de corte poder ser revista depois sem perder o histórico do que o
  // sistema achava na época.
  pontuacao     Int                     @default(0)

  confirmadoPorUserId String?
  confirmadoEm        DateTime?
  criadoEm            DateTime  @default(now())

  @@unique([apontamentoId, achadoId])
  @@index([companyId])
  @@index([achadoId])
}

// ============================================================================
// Rastreabilidade das ações humanas
// ============================================================================
// Trilha append-only de tudo que uma pessoa faz neste sistema: tratar achado,
// mudar parâmetro do modelo de gestão, mudar meta do BSC, disparar sync ou
// relatório manualmente, cadastrar conexão.
//
// Num sistema cujo produto é apontar o erro dos outros, quem mexe no próprio
// sistema tem que ficar registrado — senão a primeira pergunta de qualquer
// auditor externo ("quem desligou este alerta, e quando?") não tem resposta.
// Nunca atualizada nem apagada.
model ControladoriaEventLog {
  id           String   @id @default(cuid())
  companyId    String
  userId       String?
  userNome     String?
  userEmail    String?
  acao         String
  entidadeTipo String?
  entidadeId   String?
  descricao    String
  antes        Json?
  depois       Json?
  // IP e user-agent da requisição. Guardados porque um registro de "quem" sem
  // "de onde" perde metade do valor forense quando a credencial em si é o que
  // está sob suspeita.
  ip           String?
  userAgent    String?
  criadoEm     DateTime @default(now())

  @@index([companyId, criadoEm])
  @@index([companyId, entidadeTipo, entidadeId])
}

// TENTATIVAS DE LOGIN — freio de força bruta e trilha de autenticação.
//
// Duas necessidades que a mesma tabela resolve, e que separadas ficariam
// incoerentes entre si:
//
//   1) Freio. O login aceitava tentativas ilimitadas. O bcrypt encarece cada
//      uma, mas encarecer não é impedir: com uma lista de senhas comuns e
//      tempo, dá para chegar lá. Contar as falhas recentes por e-mail e por
//      origem é o que transforma "caro" em "bloqueado".
//
//   2) Trilha. Não havia registro de quem entrou, de onde, nem de quem tentou
//      e falhou. Num sistema sob fiscalização trabalhista e fiscal, isso é
//      lacuna de conformidade antes de ser lacuna de segurança — e a pergunta
//      "alguém andou tentando entrar na conta do financeiro?" não tinha onde
//      ser respondida.
//
// Fica FORA do ControladoriaEventLog de propósito: aquele exige companyId, e
// uma tentativa com e-mail desconhecido — que é justamente a mais suspeita —
// não tem empresa a que pertencer.
//
// Não guarda senha, nem hash de senha, nem nada derivado dela. O que se quer
// saber é a frequência e a origem, nunca o conteúdo.
model TentativaLogin {
  id        String   @id @default(cuid())
  // Normalizado em minúsculas na gravação: senão "Fulano@x.com" e
  // "fulano@x.com" seriam dois contadores, e o freio contaria pela metade.
  email     String
  ip        String?
  sucesso   Boolean
  // Por que falhou: "senha", "desconhecido", "inativo", "sem_permissao",
  // "bloqueado". Distingue ataque de gente que esqueceu a senha.
  motivo    String?
  userAgent String?
  criadoEm  DateTime @default(now())

  @@index([email, criadoEm])
  @@index([ip, criadoEm])
}

// FALHA DE SERVIDOR, GRAVADA ONDE DÁ PARA LER.
//
// A tela de erro mostra um `digest` e diz "informe esse identificador junto com
// o nome da tela". A frase pressupõe que alguém tem acesso ao log da
// hospedagem e sabe procurar nele — e, na prática, não tem: cada falha virava
// uma rodada de "exporte o CSV do log da Vercel e me mande". Três rodadas
// assim custaram mais que o conserto de qualquer um dos erros.
//
// Aqui o digest deixa de ser um número solto e passa a ter a mensagem ao lado,
// dentro do próprio sistema, na tela de sincronização, para quem já tem
// permissão de ver o estado do módulo.
//
// O QUE NÃO ENTRA: a mensagem passa por redação antes de ser gravada. Exceção
// de servidor carrega string de conexão, chave de API e, no pior caso, trecho
// do dado que causou o erro — e este registro é lido por gente que não precisa
// ver nada disso. Ver `redigir()` em falhas.ts.
//
// Fica FORA do ControladoriaEventLog pelo mesmo motivo do TentativaLogin:
// aquele exige companyId, e uma falha ao montar a página pode acontecer antes
// de haver sessão — que é justamente o caso mais difícil de diagnosticar.
model FalhaDeServidor {
  id       String   @id @default(cuid())
  // O mesmo identificador que a tela de erro mostra. É a chave que liga o
  // relato ("deu erro 2799718439") ao que de fato aconteceu.
  digest   String?
  // "render" (montagem de página), "route" (rota de API) ou "action".
  origem   String?
  rota     String?
  // Método e caminho da requisição, quando o Next os informa.
  metodo   String?
  mensagem String
  // Primeiras linhas da pilha, já redigidas. O suficiente para localizar o
  // arquivo; não o suficiente para virar despejo de código na tela.
  pilha    String?
  // Commit do build que estava no ar quando a falha aconteceu. É o que separa
  // "já corrigido" de "acontecendo agora" sem obrigar ninguém a comparar
  // horários com a última publicação. Nulo nas linhas gravadas antes desta
  // coluna existir.
  commitDoBuild String?
  criadoEm DateTime @default(now())

  @@index([criadoEm])
  @@index([digest])
}

// CLASSIFICAÇÃO DE CADA CATEGORIA NUMA LINHA DO DRE.
//
// A estrutura do DRE é fixa (Lei 6.404/76, art. 187) e vive no código; o que
// vive aqui é a ligação entre o plano de categorias REAL da empresa e essa
// estrutura. Precisa ser dado, e não regra no código, por um motivo concreto:
// a Omie informa se a categoria é receita ou despesa, mas não se uma despesa é
// CUSTO do serviço ou DESPESA operacional — e é essa linha que separa lucro
// bruto de resultado operacional. Combustível é custo, contabilidade é
// despesa, e nenhuma marca no cadastro distingue os dois.
//
// O sistema propõe, uma pessoa confirma. `origem` guarda essa diferença
// porque um DRE montado só com palpite não pode ser apresentado como
// conferido.
model DreClassificacao {
  id              String   @id @default(cuid())
  companyId       String
  // Sem conexaoId de propósito: o plano de categorias é o mesmo nas duas
  // empresas do grupo, e classificar o mesmo código duas vezes seria a forma
  // mais rápida de as duas divergirem sem ninguém notar.
  categoriaCodigo String
  linha           String
  // Subgrupo livre, para a análise que a empresa montar por cima da estrutura
  // legal ("Frota", "Pessoal operacional", "Sede"). Nulo = sem subtotal.
  subgrupo        String?
  origem          String   @default("PROPOSTA")
  userNome        String?
  observacao      String?
  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt

  @@unique([companyId, categoriaCodigo])
  @@index([companyId, linha])
}

// PERFIL DE ACESSO — a camada de AUTORIZAÇÃO da Controladoria.
//
// A IDENTIDADE continua sendo a do sistema de gestão: quem entra, com que
// senha, e se ainda está ativo. Este sistema não tem cadastro de usuários
// próprio, e a razão é de segurança, não de arquitetura — com dois cadastros,
// desligar alguém passaria a depender de alguém lembrar de repetir a operação
// nos dois lugares.
//
// O que mora aqui é o que cada pessoa ALCANÇA dentro da Controladoria. Os
// cinco papéis da frota descrevem a operação, não a controladoria: não há como
// expressar "vê o DRE mas não trata achado" criando papel de motorista.
model PerfilAcesso {
  id           String          @id @default(cuid())
  companyId    String
  nome         String
  descricao    String?
  // Chaves de permissão — ver src/lib/acessos.ts. Array e não tabela de
  // junção: a lista é pequena, fechada, sempre lida inteira, e nunca
  // consultada pelo avesso.
  permissoes   String[]        @default([])
  padrao       Boolean         @default(false)
  usuarios     UsuarioPerfil[]
  criadoEm     DateTime        @default(now())
  atualizadoEm DateTime        @updatedAt

  @@unique([companyId, nome])
  @@index([companyId])
}

// `userId` é o id do usuário NO BANCO DA GESTÃO, sem chave estrangeira: os dois
// bancos são separados e uma FK entre eles é impossível por construção. Apagar
// um usuário lá deixa a linha órfã aqui — inofensiva, porque sem usuário não há
// sessão a autorizar.
model UsuarioPerfil {
  id            String       @id @default(cuid())
  companyId     String
  userId        String
  perfilId      String
  perfil        PerfilAcesso @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  userNome      String?
  atribuidoPor  String?
  criadoEm      DateTime     @default(now())
  atualizadoEm  DateTime     @updatedAt

  @@unique([companyId, userId])
  @@index([perfilId])
}
